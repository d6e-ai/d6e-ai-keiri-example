{
	"name": "d6e-custom-frontend-skills",
	"description": "Agent Skills + reference AI accounting frontend showing how to build a custom UI on d6e's /api/workflows/execute-by-intent",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write \"src/**/*.{ts,js,mjs,svelte,json,md}\" \"scripts/**/*.{mjs,md}\" \"skills/**/*.md\" \"*.md\" \"*.json\"",
		"format:check": "prettier --check \"src/**/*.{ts,js,mjs,svelte,json,md}\" \"scripts/**/*.{mjs,md}\" \"skills/**/*.md\" \"*.md\" \"*.json\"",
		"init": "node --env-file=.env scripts/init-workspace.mjs"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@inlang/paraglide-js": "^2.15.0",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^22.19.19",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.53.12",
		"svelte-check": "^4.4.5",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"marked": "^17.0.6",
		"zod": "^4.1.0"
	}
}
