# Base URL of the d6e instance.
# Managed deployments expose both the Rust API (/api/v1/...) and the
# SvelteKit frontend (/api/workflows/...) on the same origin, so the two
# variables below usually point at the same host. Keep them separate in
# case you ever run a split deployment.
D6E_API_URL=https://b-button.d6e.ai
D6E_FRONTEND_URL=https://b-button.d6e.ai

# UUID of the workspace this app should operate on.
# Every user of this example app shares the same workspace.
D6E_WORKSPACE_ID=

# d6e-auth (token issuer) base URL.
# Use https://www.d6e.ai for d6e-managed instances. Self-hosted setups
# should point at their own d6e-auth deployment.
D6E_AUTH_URL=https://www.d6e.ai

# OAuth client credentials issued by d6e-auth for your d6e instance.
# Obtained from your d6e-auth dashboard when the instance was registered.
# Required for the server-side token manager to refresh access tokens.
D6E_AUTH_CLIENT_ID=
D6E_AUTH_CLIENT_SECRET=

# Long-lived refresh token (`auth-refresh` cookie value).
# Copy the value of the `auth-refresh` cookie from a logged-in browser
# session on D6E_FRONTEND_URL. The server will exchange it for a fresh
# 1-hour access token on every restart and whenever the cached token is
# about to expire, so you do NOT need to paste a short-lived access
# token here.
D6E_REFRESH_TOKEN=
