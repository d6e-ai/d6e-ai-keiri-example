# Base URLs of the d6e instance.
#
# - D6E_API_URL points at the d6e Rust API (used for file upload /
#   delete against /api/v1/workspaces/{id}/files/...).
# - D6E_FRONTEND_URL points at the d6e SvelteKit frontend (used for
#   workflow execution at /api/workflows/execute-by-intent, chat
#   session CRUD at /api/chat-sessions, and OAuth token refresh at
#   /api/v1/auth/token).
#
# Managed deployments expose both surfaces on the same origin so the two
# variables below usually point at the same host. Keep them separate in
# case you ever run a split deployment.
D6E_API_URL=https://b-button.d6e.ai
D6E_FRONTEND_URL=https://b-button.d6e.ai

# UUID of the workspace this app should operate on.
# Every user of this example app shares the same workspace.
D6E_WORKSPACE_ID=

# Long-lived refresh token (`auth-refresh` cookie value).
#
# Copy the value of the `auth-refresh` cookie from a logged-in browser
# session on D6E_FRONTEND_URL. The server will exchange it for a fresh
# 1-hour access token on every restart and whenever the cached token is
# about to expire, so you do NOT need to paste a short-lived access
# token here.
#
# Why no client_id / client_secret here?
#   Refresh runs against ${D6E_FRONTEND_URL}/api/v1/auth/token, which
#   only requires the refresh token itself — the b-button instance
#   already knows which OAuth client backs it. This also means tokens
#   issued during refresh always carry the audience claim that the
#   same instance validates against, so we cannot get into the
#   "audience mismatch" situation that the central d6e-auth endpoint
#   would cause.
D6E_REFRESH_TOKEN=
