# Base URL of the d6e instance.
#
# Managed deployments (e.g. https://your-d6e-instance.example.com)
# expose every d6e surface this app talks to on the same origin
# behind a reverse proxy
# that routes by path:
#   - /api/v1/...                  -> Rust API (file upload / delete /
#                                     workspaces / memberships)
#   - /api/workflows/...           -> SvelteKit frontend
#                                     (execute-by-intent)
#   - /api/chat-sessions[/...]     -> SvelteKit frontend
#   - /api/workspace-prompt-rules  -> SvelteKit frontend (init script)
#
# Because every endpoint lives on the same origin, this app collapses
# them behind a single base URL. If you ever need to split the Rust API
# and the SvelteKit frontend across different hosts, reintroduce a
# dedicated accessor in src/lib/server/env.ts and update the callers in
# src/lib/server/d6e-client.ts.
D6E_BASE_URL=https://your-d6e-instance.example.com

# UUID of the workspace this app should operate on.
# Every user logging into this app is checked for membership of this
# workspace; non-members are redirected to /auth/no-access.
D6E_WORKSPACE_ID=

# ----------------------------------------------------------------------
# OAuth2 (d6e-auth) -- USER LOGIN
# ----------------------------------------------------------------------
#
# This app uses d6e-auth (https://github.com/d6e-ai/d6e-auth) to log
# users in. Each end user is redirected to D6E_AUTH_URL, authenticates
# with their own credentials, and is bounced back to D6E_AUTH_REDIRECT_URI
# with a one-shot authorization code. The server then exchanges that
# code for a short-lived access token + long-lived refresh token, both
# stored in HTTP-only cookies on the user's browser.
#
# Prerequisites (one-time setup by the d6e-auth administrator):
#   1. Create a registered_client row for this app on d6e-auth.
#   2. Add the public callback URL of every environment to its
#      redirect_uris array, e.g.
#        - http://localhost:5173/auth/callback   (local dev)
#        - https://your-deploy.vercel.app/auth/callback   (production)
#   3. Copy the issued client_id / client_secret into the variables
#      below.

# Base URL of the d6e-auth instance that issues JWTs.
D6E_AUTH_URL=https://www.d6e.ai

# Client ID assigned by d6e-auth to this app.
D6E_AUTH_CLIENT_ID=

# Client secret paired with the client ID above. Never expose to the
# browser; only the SvelteKit server reads this value when exchanging
# authorization codes for tokens.
D6E_AUTH_CLIENT_SECRET=

# Callback URL this app exposes for the OAuth2 redirect.
# Must EXACTLY match one of the strings registered in
# registered_client.redirectUris on d6e-auth.
D6E_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# ----------------------------------------------------------------------
# Optional: workspace prompt-rule bootstrap script
# ----------------------------------------------------------------------
#
# scripts/init-workspace.mjs registers this app's workspace prompt rule
# on d6e from your developer machine. It needs a refresh token that
# belongs to a workspace ADMIN (not an end user) so the POST to
# /api/workspace-prompt-rules is accepted.
#
# Copy the `auth-refresh` cookie value of a logged-in admin session on
# D6E_BASE_URL into the variable below. The script will exchange it for
# an access token automatically.
#
# This is independent from the end-user OAuth flow above and only used
# by `npm run init`.
D6E_INIT_REFRESH_TOKEN=
