# Base URL of the d6e SvelteKit frontend.
# On managed deployments such as https://b-button.d6e.ai this single host
# serves both the SvelteKit frontend (/api/workflows/execute-by-intent) and
# the Rust API (/api/v1/...) on the same origin, so D6E_API_URL can be left
# empty below.
# Example for local dev: http://localhost:5173
D6E_FRONTEND_URL=https://b-button.d6e.ai

# OPTIONAL — only set this if the Rust API is on a different host than the
# SvelteKit frontend (e.g. a separated local dev where the API runs on
# http://localhost:8000). If empty, the app falls back to D6E_FRONTEND_URL.
D6E_API_URL=

# Bearer access token issued by d6e-auth. The same JWT works for both the
# Rust API (files/multipart) and the SvelteKit frontend (execute-by-intent).
# Obtain it by logging into the d6e frontend and copying the `auth-token`
# cookie value from your browser dev tools. The default lifetime is 1 hour;
# refresh it from the d6e UI when you start hitting 401s.
D6E_JWT=

# UUID of the workspace this app should operate on. Every user of this
# example app shares the same workspace.
D6E_WORKSPACE_ID=

# Workspace prompt rules use cookie-based auth (not Bearer), so the bootstrap
# script needs the raw `auth-token` cookie value separately. The value is the
# same JWT as D6E_JWT in practice; it is split into its own variable so the
# init script does not depend on the runtime Bearer being present.
# Required only when running `npm run init`.
D6E_AUTH_COOKIE=
