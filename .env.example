# Base URL of the d6e Rust API server (used for file uploads).
# Example for local dev: http://localhost:8000
D6E_API_URL=http://localhost:8000

# Base URL of the d6e SvelteKit frontend (used for /api/workflows/execute-by-intent).
# Example for local dev: http://localhost:5173
D6E_FRONTEND_URL=http://localhost:5173

# Bearer access token issued by d6e-auth. The same JWT works for both the
# Rust API (files) and the SvelteKit frontend (execute-by-intent).
# Obtain it by logging into the d6e frontend and copying the `auth-token`
# cookie value from your browser dev tools.
D6E_JWT=

# UUID of the workspace this app should operate on.
# Every user of this example app shares the same workspace.
D6E_WORKSPACE_ID=

# Workspace prompt rules use cookie-based auth (not Bearer), so the bootstrap
# script needs the raw `auth-token` cookie value separately.
# Required only when running `npm run init`.
D6E_AUTH_COOKIE=
