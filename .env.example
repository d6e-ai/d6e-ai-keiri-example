# Base URL of the d6e instance.
#
# Managed deployments (e.g. https://b-button.d6e.ai) expose every d6e
# surface this app talks to on the same origin behind a reverse proxy
# that routes by path:
#   - /api/v1/...                  -> Rust API (file upload / delete)
#   - /api/workflows/...           -> SvelteKit frontend
#       (execute-by-intent)
#   - /api/chat-sessions[/...]     -> SvelteKit frontend
#   - /api/workspace-prompt-rules  -> SvelteKit frontend (init script)
#   - /api/v1/auth/token           -> SvelteKit frontend (refresh)
#
# Because every endpoint lives on the same origin, this app collapses
# them behind a single base URL. If you ever need to split the Rust API
# and the SvelteKit frontend across different hosts, reintroduce a
# dedicated accessor in src/lib/server/env.ts and update the callers in
# src/lib/server/d6e-client.ts.
D6E_BASE_URL=https://b-button.d6e.ai

# UUID of the workspace this app should operate on.
# Every user of this example app shares the same workspace.
D6E_WORKSPACE_ID=

# Long-lived refresh token (`auth-refresh` cookie value).
#
# Copy the value of the `auth-refresh` cookie from a logged-in browser
# session on D6E_BASE_URL. The server will exchange it for a fresh
# 1-hour access token on every restart and whenever the cached access
# token is about to expire, so you do NOT need to paste a short-lived
# access token here.
#
# Why no client_id / client_secret here?
#   Refresh runs against ${D6E_BASE_URL}/api/v1/auth/token, which only
#   requires the refresh token itself — the b-button instance already
#   knows which OAuth client backs it. This also means tokens issued
#   during refresh always carry the audience claim that the same
#   instance validates against, so we cannot get into the
#   "audience mismatch" situation that the central d6e-auth endpoint
#   would cause.
D6E_REFRESH_TOKEN=
